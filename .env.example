# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=relay
DB_USER=relay
DB_PASSWORD=relay
# Optional; defaults to prefer (TLS when available, falls back to plaintext).
# Use require/verify-full for remote DBs.
DB_SSLMODE=prefer

# Server
PORT=8080

# Shopify
SHOPIFY_WEBHOOK_SECRET=

# Klaviyo
KLAVIYO_API_KEY=
# Optional; defaults to https://a.klaviyo.com
KLAVIYO_BASE_URL=

# Worker
MAX_RETRIES=5
RETRY_INITIAL_INTERVAL=1s
RETRY_MULTIPLIER=2.0
MAX_EVENT_AGE=24h
WORKER_POLL_INTERVAL=5s
